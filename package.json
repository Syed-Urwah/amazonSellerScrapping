{
  "name": "serverless",
  "version": "1.0.0",
  "description": "Example of creating a function that runs as a cron job using the serverless `schedule` event",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "sls offline",
    "scrape_florida": "sls invoke local --function scraper_florida",
    "scraper_florida_update_client_connection": "sls invoke local --function scraper_florida_update_client_connection",
    "build": "sls package",
    "deploy": "sls deploy --aws-profile amazon-scrape",
    "db_introspect": "drizzle-kit introspect:pg"
  },
